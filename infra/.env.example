# Copy to `docker/.env` before running docker compose.

# AIRFLOW_UID: the user Airflow runs as inside the container.
#   Linux / macOS -> the output of `id -u` (1000, for instance)
#   Windows       -> 0, otherwise the container cannot write into data/
AIRFLOW_UID=0

# NewsData.io key (optional) - the same one as in the project's root .env.
NEWSDATA_API_KEY=

# Target database (optional) - empty => local SQLite in data/db/multimodal_etl.db.
MULTIMODAL_ETL_DB_URL=
