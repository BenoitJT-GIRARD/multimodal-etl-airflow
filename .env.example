# Copy this file to `.env`, then fill in what you need.
# The pipeline runs with none of it: the RSS feeds need no key, and the Fakeddit source falls
# back to the versioned sample under data/samples/. The variables below turn on the optional
# source, move where a run writes, and steer which sources it reads.

# --- NewsData.io, the one source that needs a key ---
# Free key: https://newsdata.io/register
# Left empty, the source turns itself off cleanly and the other three carry on. That is a
# configuration choice and not an outage, and the failed-sources indicator stays at zero.
NEWSDATA_API_KEY=

# --- Where the load writes ---
# Default: local SQLite at <data dir>/db/multimodal_etl.db. Nothing to do.
# To target a PostgreSQL, give the SQLAlchemy URL:
# postgresql+psycopg2://user:password@host:5432/postgres
MULTIMODAL_ETL_DB_URL=

# --- Where a run reads and writes ---
# Default: `data/` beside the code. Absolute, or relative to the project root. A test that
# runs the pipeline for real, and the capture script, each point it at a directory of their
# own rather than at the one your own runs have been filling.
MULTIMODAL_ETL_DATA_DIR=

# --- Which sources run, and where the feed reader points ---
# A comma-separated subset of: rss, newsdata, fakenewsnet, kaggle_fakeddit. Empty means all
# four. Replaying one source after an outage is a normal operation, and it used to mean
# editing the connector table.
MULTIMODAL_ETL_SOURCES=

# `label=url,label=url`. Empty means the three shipped feeds — The Guardian, BBC, ABC News.
MULTIMODAL_ETL_RSS_FEEDS=

# --- Run parameters, all optional ---
# Largest number of items collected per source, a guard against API quotas.
MULTIMODAL_ETL_MAX_ITEMS_PER_SOURCE=50
# Timeout, in seconds, of every HTTP request.
MULTIMODAL_ETL_REQUEST_TIMEOUT=15
# Largest number of images downloaded per run. Keep it above the collected volume, or the
# sources processed last get no image and drop out of the dataset.
MULTIMODAL_ETL_MAX_IMAGES=250
# How many FakeNewsNet articles are visited for their Open Graph image. One HTTP request
# each, so this is what keeps a run short.
MULTIMODAL_ETL_MAX_OPEN_GRAPH=40

# --- Taking the screenshots ---
# The browser scripts/capture.py drives, when it is not on PATH. A path hard-coded in the
# script would be one machine's installation shipped inside a published repository.
CHROME_PATH=
