# Copy this file to `.env`, then fill in the values.
# The pipeline runs with no key at all (RSS sources + the FakeNewsNet sample).
# The variables below turn the optional sources on.

# --- NewsData.io (optional API source) ---
# Free key: https://newsdata.io/register
NEWSDATA_API_KEY=

# --- Load target database ---
# Default: local SQLite (data/db/multimodal_etl.db). Nothing to do.
# To target a PostgreSQL / Supabase, give the SQLAlchemy URL:
# postgresql+psycopg2://user:password@host:5432/postgres
MULTIMODAL_ETL_DB_URL=

# --- Run parameters (optional) ---
MULTIMODAL_ETL_MAX_ITEMS_PER_SOURCE=50
MULTIMODAL_ETL_REQUEST_TIMEOUT=15
