# Copier ce fichier en `.env` puis renseigner les valeurs.
# Le pipeline fonctionne sans aucune cle (sources RSS + echantillon FakeNewsNet).
# Les variables ci-dessous activent les sources optionnelles.

# --- NewsData.io (source API optionnelle) ---
# Cle gratuite : https://newsdata.io/register
NEWSDATA_API_KEY=

# --- Base de donnees de chargement ---
# Par defaut : SQLite local (data/db/multimodal_etl.db). Aucune action requise.
# Pour cibler un PostgreSQL / Supabase, renseigner l'URL SQLAlchemy :
# postgresql+psycopg2://user:password@host:5432/postgres
MULTIMODAL_ETL_DB_URL=

# --- Parametres d'execution (optionnels) ---
MULTIMODAL_ETL_MAX_ITEMS_PER_SOURCE=50
MULTIMODAL_ETL_REQUEST_TIMEOUT=15
