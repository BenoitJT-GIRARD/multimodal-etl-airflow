# Copier en `docker/.env` avant de lancer docker compose.
# AIRFLOW_UID : sous Linux/macOS, mettre la sortie de `id -u`. Sous Windows, 50000 convient.
AIRFLOW_UID=50000

# Cle NewsData.io (optionnelle) — la meme que dans le .env racine du projet.
NEWSDATA_API_KEY=

# Base cible (optionnelle) — vide => SQLite local dans data/db/multimodal_etl.db.
MULTIMODAL_ETL_DB_URL=
